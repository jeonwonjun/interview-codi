# 이 파일을 .env로 복사해 값을 채운다. .env는 Git에서 제외된다.
# docker compose와 Spring 서버(backend/src/main/resources/application.properties)가 함께 읽는다.

# 카카오 개발자 콘솔 > 앱 > 앱 키의 REST API 키
KAKAO_CLIENT_ID=
# 카카오 개발자 콘솔 > 카카오 로그인 > 보안 > Client Secret (활성화 필요)
KAKAO_CLIENT_SECRET=

# Gemini API 키(Google AI Studio). 개발·평가는 무료 등급 키, 실제 사용자 UT는 결제를 연결한 유료 등급 키.
GEMINI_API_KEY=
# OpenAI API 키(platform.openai.com). 실제 사용자 답변은 학습에 쓰지 않는 API 키로만 보낸다.
OPENAI_API_KEY=
# AI 생성기: fake(기본), openai, gemini
# AI_PROVIDER=openai

# 아래는 비워 두면 기본값을 사용한다.
# POSTGRES_PORT=5433
# DB_URL=jdbc:postgresql://localhost:5433/interview_codi
